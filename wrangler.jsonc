{
  "name": "upflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": { "UPFLARE_INSTALL_SOURCE": "git" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upflare",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/status-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/beat/*", "/admin", "/admin/*"]
  },
  "observability": { "enabled": true }
}
