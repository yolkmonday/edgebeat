{
  "name": "upflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  },
  "scripts": {
    "test": "bun test && vitest run && bun --cwd cli test",
    "build": "vite build && vite build -c vite.admin.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/status-page && tsc --noEmit -p src/admin",
    "deploy": "bun run build && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "dev": "bun run build && wrangler dev --test-scheduled",
    "dev:admin": "vite -c vite.admin.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "packageManager": "bun@1.3.11",
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password for the Upflare admin. **At least 12 characters**, not `change-me`."
      },
      "ENCRYPTION_KEY": {
        "description": "32 random bytes, base64. Generate with `openssl rand -base64 32`."
      }
    }
  }
}
