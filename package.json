{
  "name": "edgebeat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  },
  "scripts": {
    "test": "bun test && vitest run && bun --cwd cli test",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/status-page",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "vite build && wrangler dev --test-scheduled",
    "db:generate": "drizzle-kit generate"
  },
  "packageManager": "bun@1.3.11",
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password for the Edgebeat admin. **At least 12 characters**, not `change-me`."
      },
      "ENCRYPTION_KEY": {
        "description": "32 random bytes, base64. Generate with `openssl rand -base64 32`."
      }
    }
  }
}
